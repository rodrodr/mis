  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Squared paper ticket: uppercase mono label, hairline control border, 4px corners.",
      "html": "<a class=\"ds-boton\" href=\"#\">Open the map</a>",
      "css": ".ds-boton{display:inline-flex;align-items:center;min-block-size:var(--size-target);padding-inline:var(--space-s);background:var(--color-bg-raised);color:var(--color-text-primary);border:var(--border-width-hairline) solid var(--color-border-control);border-radius:var(--radius-sm);font-family:var(--font-family-mono);font-size:var(--font-size-step-minus-1);text-transform:uppercase;letter-spacing:0.03em;text-decoration:none}.ds-boton:focus-visible{outline:var(--border-width-focus) solid var(--color-focus-ring);outline-offset:var(--border-width-focus)}"
    },
    {
      "name": "Button (pressed)",
      "kind": "button",
      "refersTo": "button-pressed",
      "description": "Toggle state (Play): inverts to ink with paper text.",
      "html": "<button type=\"button\" class=\"ds-boton-p\" aria-pressed=\"true\">Pause</button>",
      "css": ".ds-boton-p{min-block-size:var(--size-target);padding-inline:var(--space-s);border:var(--border-width-hairline) solid var(--color-border-control);border-radius:var(--radius-sm);font-family:var(--font-family-mono);font-size:var(--font-size-step-minus-1);text-transform:uppercase;letter-spacing:0.03em;background:var(--color-bg-raised);color:var(--color-text-primary)}.ds-boton-p[aria-pressed=\"true\"]{background:var(--color-text-primary);color:var(--color-bg-raised)}.ds-boton-p:focus-visible{outline:var(--border-width-focus) solid var(--color-focus-ring);outline-offset:var(--border-width-focus)}"
    },
    {
      "name": "Search (receipt input line)",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Dashed-border paper input under an uppercase mono label.",
      "html": "<label class=\"ds-busca\"><span>Find a municipality</span><input type=\"search\" placeholder=\"Name or IBGE code\"></label>",
      "css": ".ds-busca{display:flex;flex-direction:column;gap:var(--space-3xs);max-inline-size:30rem}.ds-busca span{font-family:var(--font-family-mono);font-size:var(--font-size-step-minus-1);text-transform:uppercase;letter-spacing:0.04em;color:var(--color-text-primary)}.ds-busca input{font:inherit;font-family:var(--font-family-mono);min-block-size:var(--size-target);padding:var(--space-2xs) var(--space-xs);background:var(--color-bg-raised);color:var(--color-text-primary);border:var(--border-width-hairline) dashed var(--color-border-control);border-radius:var(--radius-sm)}.ds-busca input:focus-visible{outline:var(--border-width-focus) solid var(--color-focus-ring);outline-offset:var(--border-width-focus)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Uppercase mono links; current page has a wavy underline, current language is bracketed.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Evolution</a><a href=\"#\">Map</a><a href=\"#\">Methodology</a><span class=\"ds-nav__lang\"><a href=\"#\" aria-current=\"true\">en</a><a href=\"#\">pt</a><a href=\"#\">es</a></span></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:0 var(--space-s);align-items:center;background:var(--color-bg-raised);padding:var(--space-2xs) var(--space-s);border-block-end:var(--border-width-hairline) dashed var(--color-paper-tear)}.ds-nav a{display:inline-flex;align-items:center;min-block-size:var(--size-target);font-family:var(--font-family-mono);font-size:var(--font-size-step-minus-1);text-transform:uppercase;letter-spacing:0.04em;text-decoration:none;color:var(--color-text-primary)}.ds-nav a[aria-current=\"page\"]{text-decoration:underline;text-decoration-style:wavy;text-underline-offset:0.35em;text-decoration-thickness:var(--border-width-hairline)}.ds-nav a:focus-visible{outline:var(--border-width-focus) solid var(--color-focus-ring);outline-offset:var(--border-width-focus)}.ds-nav__lang{display:flex;gap:var(--space-3xs);margin-inline-start:auto}.ds-nav__lang [aria-current=\"true\"]{font-weight:700}.ds-nav__lang [aria-current=\"true\"]::before{content:\"[\"}.ds-nav__lang [aria-current=\"true\"]::after{content:\"]\"}"
    },
    {
      "name": "Stamp",
      "kind": "chip",
      "refersTo": "stamp",
      "description": "Rubber stamp for data state: double rule, -4 degree rotation, always beside a plain note.",
      "html": "<p class=\"ds-sello-fila\"><span class=\"ds-sello\">Provisional</span><span>First-round boletins of 5 Oct 2026.</span></p>",
      "css": ".ds-sello-fila{display:flex;gap:var(--space-xs);align-items:center;color:var(--color-text-secondary);font-size:var(--font-size-step-minus-1)}.ds-sello{display:inline-block;padding:0.15em 0.55em;border:2px solid currentColor;border-radius:var(--radius-sm);outline:1px solid currentColor;outline-offset:2px;font-family:var(--font-family-mono);font-size:var(--font-size-step-minus-2);font-weight:700;letter-spacing:0.12em;text-transform:uppercase;transform:rotate(-4deg);color:var(--color-text-primary)}"
    },
    {
      "name": "Receipt",
      "kind": "card",
      "refersTo": "receipt",
      "description": "Signature boletim: torn-edged paper slip, one block per office, one row per election with a printed strip.",
      "html": "<section class=\"ds-recibo\"><header class=\"ds-recibo__cab\"><strong>MIS · 1994–2026 · 5,571 municipalities</strong></header><h3 class=\"ds-recibo__sec\">Federal deputy · general elections</h3><div class=\"ds-recibo__fila\"><span>2022</span><span class=\"ds-tira\"><i class=\"ds-tira__cero\" style=\"inset-inline-start:50%\"></i><i class=\"ds-tira__el\" style=\"inset-inline-start:66%\"></i><i class=\"ds-tira__ti\" style=\"inset-inline-start:69%\"></i></span><span>+0.190</span></div><div class=\"ds-recibo__fila\"><span>2026</span><span class=\"ds-tira\"><i class=\"ds-tira__cero\" style=\"inset-inline-start:50%\"></i><i class=\"ds-tira__el\" style=\"inset-inline-start:68%\"></i><i class=\"ds-tira__ti\" style=\"inset-inline-start:71%\"></i></span><span>+0.208*</span></div></section>",
      "css": ".ds-recibo{--dente:0.6rem;max-inline-size:27rem;background:var(--color-bg-raised);color:var(--color-text-primary);font-family:var(--font-family-mono);font-size:var(--font-size-step-minus-1);padding:calc(var(--space-m) + var(--dente)) var(--space-m);--a:url(\"data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2712%27 height=%276%27%3E%3Cpath d=%27M0 6L6 0L12 6Z%27/%3E%3C/svg%3E\");--b:url(\"data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2712%27 height=%276%27%3E%3Cpath d=%27M0 0L6 6L12 0Z%27/%3E%3C/svg%3E\");-webkit-mask:var(--a) top left/12px 6px repeat-x,linear-gradient(#000 0 0) center/100% calc(100% - 12px) no-repeat,var(--b) bottom left/12px 6px repeat-x;mask:var(--a) top left/12px 6px repeat-x,linear-gradient(#000 0 0) center/100% calc(100% - 12px) no-repeat,var(--b) bottom left/12px 6px repeat-x;filter:drop-shadow(0 1px 0 var(--color-paper-edge))}.ds-recibo__cab{text-align:center;text-transform:uppercase;letter-spacing:0.05em}.ds-recibo__sec{margin-block:var(--space-s) var(--space-2xs);padding-block-start:var(--space-xs);border-block-start:var(--border-width-focus) dashed var(--color-paper-tear);font-size:var(--font-size-step-minus-2);font-weight:400;text-transform:uppercase;letter-spacing:0.05em}.ds-recibo__fila{display:grid;grid-template-columns:3.4em minmax(0,1fr) 5.6em;align-items:center;gap:var(--space-2xs);min-block-size:1.6em;font-variant-numeric:tabular-nums}.ds-recibo__fila>span:last-child{text-align:end}.ds-tira{position:relative;block-size:1em;margin-block-end:0.5em;border-block-end:var(--border-width-hairline) solid var(--color-fig-grid);background:linear-gradient(90deg,var(--color-fig-grid) 1px,transparent 1px) 0 100%/25% 0.35em repeat-x}.ds-tira>i{position:absolute;inset-block-end:-0.45em;translate:-50% 0;inline-size:0.8em;block-size:0.8em;border-radius:50%}.ds-tira .ds-tira__cero{inline-size:0;block-size:1.4em;border-radius:0;inset-block-end:-0.7em;border-inline-start:var(--border-width-hairline) dotted var(--color-fig-axis)}.ds-tira .ds-tira__ti{background:var(--color-fig-ink);inline-size:0.7em;block-size:0.7em;inset-block-end:-0.4em}.ds-tira .ds-tira__el{border:1.5px solid var(--color-fig-ink);background:var(--color-bg-raised)}"
    },
    {
      "name": "Year Rail",
      "kind": "custom",
      "refersTo": "year-rail-button",
      "description": "Election picker: dashed paper tickets; the selected year is ruled in ink and punched.",
      "html": "<div class=\"ds-riel\"><span>Gen</span><button type=\"button\">2018</button><button type=\"button\">2022</button><button type=\"button\" aria-pressed=\"true\">2026</button></div>",
      "css": ".ds-riel{display:flex;flex-wrap:wrap;gap:2px;align-items:center;font-family:var(--font-family-mono);font-size:var(--font-size-step-minus-2)}.ds-riel>span{inline-size:3em;text-transform:uppercase}.ds-riel button{min-inline-size:3.1em;min-block-size:var(--size-target-min);padding:0.2em 0.3em;background:var(--color-bg-raised);color:var(--color-text-primary);border:var(--border-width-hairline) dashed var(--color-paper-tear);font:inherit}.ds-riel button:focus-visible{outline:var(--border-width-focus) solid var(--color-focus-ring);outline-offset:var(--border-width-focus)}.ds-riel button[aria-pressed=\"true\"]{border:var(--border-width-focus) solid var(--color-text-primary);font-weight:700;position:relative}.ds-riel button[aria-pressed=\"true\"]::after{content:\"\";position:absolute;inset-block-start:-0.35em;inset-inline-start:50%;translate:-50% 0;inline-size:0.55em;block-size:0.55em;border-radius:50%;background:var(--color-bg-base);border:var(--border-width-hairline) solid var(--color-text-primary)}"
    },
