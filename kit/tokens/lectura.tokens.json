  "font": {
    "family": {
      "$type": "fontFamily",
      "serif": {
        "$value": [
          "Iowan Old Style",
          "Charter",
          "Georgia",
          "serif"
        ],
        "$description": "Provisional: serif de lectura OFL autoalojada del proyecto (Literata, Source Serif 4).",
        "$extensions": {
          "es.maestro": {
            "lectura": true
          }
        }
      },
      "sans": {
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Provisional: sans de lectura (Atkinson Hyperlegible Next).",
        "$extensions": {
          "es.maestro": {
            "lectura": true
          }
        }
      },
      "dyslexic": {
        "$value": [
          "OpenDyslexic",
          "Comic Sans MS",
          "sans-serif"
        ],
        "$description": "Solo como opción del lector; la fuente la carga el proyecto (@fontsource/opendyslexic).",
        "$extensions": {
          "es.maestro": {
